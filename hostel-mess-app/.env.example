# Copy this file to  .env  (same folder) and fill in the values.
# The .env file holds your password, so it is NOT uploaded to GitHub.
#
# Where to find the values in Supabase:
#   open the project  ->  "Connect" button (top)  ->  "Session pooler"  ->  "View parameters"

DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password

# Optional: keep MessMate tables separate from other tables in the same database
# DB_SCHEMA=messmate

# Security keys for the app (change them to any long random text)
SECRET_KEY=change-me-to-a-long-random-text
GATE_API_KEY=change-this-gate-key